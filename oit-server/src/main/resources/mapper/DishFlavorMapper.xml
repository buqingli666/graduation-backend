<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.oit.mapper.DishFlavorMapper">

    <insert id="insertBatch">
        insert into dish_flavor (dish_id, name, value)
        values
        <foreach collection="list" item="flavor" separator=",">
            (#{flavor.dishId}, #{flavor.name}, #{flavor.value})
        </foreach>
    </insert>

    <delete id="deleteByDishId">
        delete from dish_flavor where dish_id = #{id,jdbcType=BIGINT}
    </delete>

    <delete id="deleteByDishIds">
        delete from dish_flavor where dish_id in
        <foreach collection="list" item="dishId" separator="," open="(" close=")">
            #{dishId,jdbcType=BIGINT}
        </foreach>
    </delete>

</mapper>
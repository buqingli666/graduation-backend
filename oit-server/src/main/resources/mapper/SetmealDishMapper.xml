<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.oit.mapper.SetmealDishMapper">

    <select id="getSetmealIdsByDishIds" resultType="java.lang.Long">
        select setmeal_id
        from setmeal_dish where dish_id in
        <foreach collection="list" item="dishId" separator="," open="(" close=")">
            #{dishId,jdbcType=BIGINT}
        </foreach>
    </select>

    <insert id="insertBatch" parameterType="list">
        insert into setmeal_dish
        (setmeal_id, dish_id, name, price, copies)
        values
        <foreach collection="list" item="sd" separator=",">
            (#{sd.setmealId,jdbcType=BIGINT}, #{sd.dishId,jdbcType=BIGINT}, #{sd.name,jdbcType=VARCHAR},
             #{sd.price,jdbcType=DECIMAL}, #{sd.copies,jdbcType=INTEGER})
        </foreach>
    </insert>

    <delete id="deleteBySetmealId">
        delete from setmeal_dish where setmeal_id = #{setmealId,jdbcType=BIGINT}
    </delete>

    <select id="getBySetmealId" resultType="com.oit.entity.SetmealDish">
        select * from setmeal_dish where setmeal_id = #{setmealId,jdbcType=BIGINT}
    </select>
</mapper>